# ---------------------------------------------------------------- required --

# MongoDB Atlas connection string. Create a database user with readWrite on the
# app database only, and add your server's IP to the Atlas Network Access list.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=mickey-mobile

# ---------------------------------------------------------------- server ----

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Browser origins allowed to call this API — the Vite dev server and the
# deployed site. Comma-separated, no trailing slash.
CORS_ORIGINS=http://localhost:5173,https://mickeymobile.in

# Reverse-proxy hop count. 1 behind a single proxy (Render, Fly, Nginx),
# 0 when the API is exposed directly. Getting this wrong breaks rate limiting.
TRUST_PROXY=1

# The shop's own timezone. "Open now" and the earliest bookable date are
# answered in this zone, not the visitor's.
SHOP_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------- admin -----

# Leave unset and the /admin routes are not mounted at all.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ---------------------------------------------------------------- google ----

# Optional. Without both, /reviews serves the shop's own seeded sample set and
# labels it `source: "sample"` so it is never passed off as a Google rating.
#
# Unlike the frontend key this one never ships to a browser, so restrict it by
# IP (this server) rather than by HTTP referrer, and enable only the
# Places API (New) on it.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=

# Seconds to hold a Places response in memory. Google's terms allow caching
# Place IDs but not review content, so this is in-process only and nothing is
# written to MongoDB.
GOOGLE_CACHE_TTL_SECONDS=300

# ------------------------------------------------------------ rate limits ---

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Bookings, registrations and lookups — the endpoints that create rows.
RATE_LIMIT_WRITE_MAX=20
