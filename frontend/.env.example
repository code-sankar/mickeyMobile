# All optional. With none of these set the site still builds and runs
# completely — it renders from the data bundled in `src/data/`, and the booking
# and registration forms submit through WhatsApp, which is how the shop worked
# before there was an API.

# ---------------------------------------------------------------- the API ---

# Base URL of the backend, including its path prefix and no trailing slash.
#   local:      http://localhost:4000/api/v1
#   deployed:   https://mickey-mobile-api.vercel.app/api/v1
#
# Set this and bookings become real tickets on the shop's system, student
# registrations are recorded, and reviews come through the server-side Google
# proxy. Leave it unset and every one of those falls back to the local path.
VITE_API_URL=

# How long to wait before giving up on the API and using the fallback.
VITE_API_TIMEOUT_MS=10000

# ------------------------------------------------------- Google (fallback) --

# Only needed if you want live Google reviews WITHOUT running the backend.
# Prefer VITE_API_URL above: this key ships inside the JS bundle and can only
# be restricted by HTTP referrer, whereas the server-side key the API uses can
# be restricted by IP.
#
# If you do use it: restrict by referrer to your domains in Google Cloud
# Console and enable only the Maps JavaScript API + Places API on it.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_PLACE_ID=
